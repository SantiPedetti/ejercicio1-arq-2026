{
  "name": "flight-reservation-pipeline",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de procesamiento de reservas de vuelos con el patron arquitectonico Pipes & Filters",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "jest --ci --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "5.2.1",
    "pino": "9.6.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.1",
    "@types/supertest": "6.0.3",
    "eslint": "9.20.0",
    "jest": "30.5.1",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0"
  }
}
